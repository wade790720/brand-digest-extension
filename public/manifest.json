{
  "manifest_version": 3,
  "name": "brand-digest",
  "description": "滑過主播的 IG 主頁，就把他的短影音整理成知識庫。",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "unlimitedStorage"],
  "host_permissions": [
    "https://*.fbcdn.net/*",
    "https://*.cdninstagram.com/*",
    "https://api.groq.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    { "matches": ["https://www.instagram.com/*"], "js": ["main-world.js"], "run_at": "document_start", "world": "MAIN" },
    { "matches": ["https://www.instagram.com/*"], "js": ["bridge.js"], "run_at": "document_start" }
  ],
  "action": { "default_title": "brand-digest" }
}
